# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Public URL of the deployed site (used for SEO / social-share links).
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Contact form (https://resend.com). Without RESEND_API_KEY the form shows a "email me directly" fallback.
RESEND_API_KEY=
# Where messages are delivered. Defaults to the email in src/data/portfolio.ts.
CONTACT_TO_EMAIL=
# Verified sender address. Defaults to Resend's shared sender "Portfolio <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=
